# Jenkins Server Configuration
JENKINS_URL=http://jenkins.local:8080
JENKINS_USER=admin
JENKINS_TOKEN=your-api-token-here
JENKINS_AUTH_METHOD=API_TOKEN

# Connection Settings
JENKINS_TIMEOUT=30
JENKINS_RETRY_COUNT=3
JENKINS_RETRY_DELAY=1.0
JENKINS_VERIFY_SSL=true

# MCP Server Configuration
MCP_SERVER_LOG_LEVEL=INFO
MCP_SERVER_JSON_LOGS=false
MCP_SERVER_LOG_FILE=jenkins-mcp.log

# FastMCP Configuration
FASTMCP_TRANSPORT=stdio
FASTMCP_HOST=localhost
FASTMCP_PORT=8081

# Security Settings
JENKINS_CRUMB_REQUIRED=true
JENKINS_SESSION_TIMEOUT=3600

# Performance Settings
JENKINS_MAX_CONCURRENT_REQUESTS=10
JENKINS_REQUEST_TIMEOUT=60

# Development Settings
JENKINS_MCP_DEBUG=false
JENKINS_MCP_MOCK_JENKINS=false